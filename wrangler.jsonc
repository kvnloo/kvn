{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kvn-public-chat",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-22",
  "workers_dev": true,
  "ai": { "binding": "AI" },
  "assets": { "directory": "./site", "binding": "ASSETS" },
  "ratelimits": [{
    "name": "RATE_LIMIT",
    "namespace_id": "1042",
    "simple": { "limit": 5, "period": 60 }
  }]
}
